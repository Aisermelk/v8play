rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return estaLogado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Perfil dos Usuários
    match /usuarios/{userId} {
      allow read, create: if estaLogado() && request.auth.uid == userId;
      allow update: if estaLogado() && request.auth.uid == userId
                    && request.resource.data.admin == resource.data.admin;
      allow delete: if false;
    }

    // Registro das compras efetuadas via Pix
    match /compras/{compraId} {
      allow read: if estaLogado() && resource.data.usuario == request.auth.uid;
      allow write: if false; // Gravado exclusivamente via Webhook da API
    }

    // Configurações Gerais (Preços dos planos PRIME/PREMIUM)
    match /configuracoes/{docId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Catálogo Público (Acesso direto para leitura rápida)
    match /filmes/{id} { allow read: if true; allow write: if ehAdmin(); }
    match /series/{id} { allow read: if true; allow write: if ehAdmin(); }
    match /animes/{id} { allow read: if true; allow write: if ehAdmin(); }
    match /doramas/{id} { allow read: if true; allow write: if ehAdmin(); }

    // Histórico e Progresso de Reprodução
    match /historico/{docId} {
      allow read, write: if estaLogado() && request.resource.data.usuario == request.auth.uid;
    }
    match /progresso/{docId} {
      allow read, write: if estaLogado() && request.resource.data.usuario == request.auth.uid;
    }
  }
}
