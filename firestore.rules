rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return estaLogado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Verifica se o usuário logado comprou este título específico
    // (documento em "compras" com ID = uid_colecao_itemId, escrito só pelo backend)
    function comprou(colecao, item) {
      return estaLogado() &&
        exists(/databases/$(database)/documents/compras/$(request.auth.uid + '_' + colecao + '_' + item)) &&
        get(/databases/$(database)/documents/compras/$(request.auth.uid + '_' + colecao + '_' + item)).data.status == 'aprovado';
    }

    // Perfil do usuário (nome, email, e o campo "admin")
    match /usuarios/{userId} {
      allow read: if estaLogado() && request.auth.uid == userId;
      allow create: if estaLogado() && request.auth.uid == userId;

      // impede que o próprio usuário se promova a admin editando o perfil
      allow update: if estaLogado() && request.auth.uid == userId
                    && request.resource.data.admin == resource.data.admin;

      allow delete: if false;
    }

    // Log de compras -- só o backend (função do Mercado Pago, com
    // credenciais de admin) escreve aqui. Cada usuário só lê as próprias.
    match /compras/{compraId} {
      allow read: if estaLogado() && resource.data.usuario == request.auth.uid;
      allow write: if false;
    }

    // Catálogo de filmes/séries/animes/doramas (coleções separadas).
    // O campo "nivel" (free/prime/premium) é só uma etiqueta visual --
    // quem controla o acesso de verdade é o preço individual + compra.
    match /filmes/{filmeId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /series/{serieId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /animes/{animeId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /doramas/{doramaId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Link do vídeo completo e do arquivo de download de cada título --
    // ficam numa subcoleção separada, só liberada pra quem comprou aquele
    // título específico (ou admin). O documento pai (capa, título,
    // descrição, trailer, selo, preço) continua público.
    match /{colecaoCatalogo}/{itemId}/protegido/{docId} {
      allow read: if ehAdmin() || comprou(colecaoCatalogo, itemId);
      allow write: if ehAdmin();
    }

    // Histórico de títulos assistidos por cada usuário
    match /historico/{docId} {
      allow read: if estaLogado() && resource.data.usuario == request.auth.uid;
      allow write: if estaLogado() && request.resource.data.usuario == request.auth.uid;
    }

    // Progresso de "continuar assistindo" (tempo do vídeo) de cada usuário
    match /progresso/{docId} {
      allow read: if estaLogado() && resource.data.usuario == request.auth.uid;
      allow write: if estaLogado() && request.resource.data.usuario == request.auth.uid;
    }
  }
}
