rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para validar se o usuário autenticado é administrador
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // 1. Configurações Públicas (Preços dos Planos)
    match /configuracoes/planos {
      allow read: if true; // Clientes e visitantes precisam ler os preços no catálogo
      allow write: if isAdmin();
    }

    // 2. Chaves de API de Pagamento (Altamente Confidencial)
    match /configuracoes/chaves_pagamento {
      allow read, write: if isAdmin(); // Apenas administradores podem ler ou alterar as chaves
    }

    // 3. Coleções de Conteúdo (Filmes, Séries, Animes, Doramas)
    match /filmes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /series/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /animes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /doramas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Gerenciamento de Usuários
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }
  }
}
