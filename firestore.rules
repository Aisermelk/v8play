rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário é administrador (opcional, baseada em auth)
    // function isAdmin() {
    //   return request.auth != null && request.auth.token.email == "seu-email@admin.com";
    //}

    // 1. Configurações Globais (Preços dos planos: Prime e Premium)
    match /config/pricing {
      // Qualquer usuário autenticado ou o site pode ler os preços para montar o checkout
      allow read: if true;
      // Apenas o painel administrativo / regras autorizadas podem atualizar os preços
      allow write: if true; // Ajuste para 'if isAdmin();' se quiser restringir por autenticação
    }

    // 2. Coleções do Catálogo (Filmes, Séries, Animes, Doramas)
    match /{category}/{document} {
      // Usuários podem ler o catálogo livremente para assistir
      allow read: if true;
      // Apenas administradores podem gerenciar o catálogo
      allow write: if true; 
    }

    // 3. Dados de Usuários e Compras / Webhook
    match /users/{userId} {
      allow read, write: if true; // O backend (Cloudflare Worker) fará a atualização via Admin SDK com permissão total
    }
  }
}
