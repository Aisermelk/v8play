// Autentica como conta de serviço do Firebase (assinando um JWT com a chave
// privada, via Web Crypto -- disponível no runtime da Cloudflare) e troca por
// um access token do Google. Depois usa esse token pra ler/escrever no
// Firestore através da API REST (sem precisar da lib "firebase-admin", que
// não roda no runtime de Workers/Pages Functions).

function base64UrlDaString(str) {
    return btoa(str).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

function base64UrlDoBuffer(buffer) {
    let binario = "";
    const bytes = new Uint8Array(buffer);
    for (const b of bytes) binario += String.fromCharCode(b);
    return btoa(binario).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

async function importarChavePrivada(pem) {
    const corpo = pem
        .replace(/-----BEGIN PRIVATE KEY-----/, "")
        .replace(/-----END PRIVATE KEY-----/, "")
        .replace(/\s/g, "");
    const bin = Uint8Array.from(atob(corpo), (c) => c.charCodeAt(0));
    return crypto.subtle.importKey(
        "pkcs8",
        bin.buffer,
        { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" },
        false,
        ["sign"]
    );
}

async function obterAccessToken(env) {
    const contaServico = JSON.parse(env.FIREBASE_SERVICE_ACCOUNT);
    const agora = Math.floor(Date.now() / 1000);

    const header = { alg: "RS256", typ: "JWT" };
    const claim = {
        iss: contaServico.client_email,
        scope: "https://www.googleapis.com/auth/datastore",
        aud: "https://oauth2.googleapis.com/token",
        exp: agora + 3600,
        iat: agora
    };

    const naoAssinado = `${base64UrlDaString(JSON.stringify(header))}.${base64UrlDaString(JSON.stringify(claim))}`;
    const chave = await importarChavePrivada(contaServico.private_key);
    const assinatura = await crypto.subtle.sign(
        "RSASSA-PKCS1-v1_5",
        chave,
        new TextEncoder().encode(naoAssinado)
    );
    const jwt = `${naoAssinado}.${base64UrlDoBuffer(assinatura)}`;

    const resposta = await fetch("https://oauth2.googleapis.com/token", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer&assertion=${jwt}`
    });

    const dados = await resposta.json();
    if (!resposta.ok) {
        throw new Error(`Erro ao obter access token: ${JSON.stringify(dados)}`);
    }
    return dados.access_token;
}

function idDoProjeto(env) {
    return JSON.parse(env.FIREBASE_SERVICE_ACCOUNT).project_id;
}

// Converte um objeto JS simples pro formato de "fields" da API REST do Firestore
function paraCamposFirestore(obj) {
    const campos = {};
    for (const [chave, valor] of Object.entries(obj)) {
        if (typeof valor === "string") campos[chave] = { stringValue: valor };
        else if (typeof valor === "number") campos[chave] = { doubleValue: valor };
        else if (typeof valor === "boolean") campos[chave] = { booleanValue: valor };
        else if (valor instanceof Date) campos[chave] = { timestampValue: valor.toISOString() };
        else campos[chave] = { stringValue: String(valor) };
    }
    return campos;
}

// Converte a resposta da API REST do Firestore de volta pra um objeto JS simples
function dosCamposFirestore(campos) {
    const obj = {};
    for (const [chave, valor] of Object.entries(campos || {})) {
        if ("stringValue" in valor) obj[chave] = valor.stringValue;
        else if ("doubleValue" in valor) obj[chave] = valor.doubleValue;
        else if ("integerValue" in valor) obj[chave] = Number(valor.integerValue);
        else if ("booleanValue" in valor) obj[chave] = valor.booleanValue;
        else if ("timestampValue" in valor) obj[chave] = valor.timestampValue;
        else obj[chave] = null;
    }
    return obj;
}

export async function lerDocumento(env, caminho) {
    const token = await obterAccessToken(env);
    const url = `https://firestore.googleapis.com/v1/projects/${idDoProjeto(env)}/databases/(default)/documents/${caminho}`;

    const resposta = await fetch(url, {
        headers: { Authorization: `Bearer ${token}` }
    });

    if (resposta.status === 404) return null;
    if (!resposta.ok) throw new Error(`Erro ao ler ${caminho}: ${await resposta.text()}`);

    const dados = await resposta.json();
    return dosCamposFirestore(dados.fields);
}

// Grava (merge) um documento, atualizando só os campos passados em "dados"
export async function gravarDocumento(env, caminho, dados) {
    const token = await obterAccessToken(env);
    const campos = paraCamposFirestore(dados);
    const mascara = Object.keys(dados).map((c) => `updateMask.fieldPaths=${encodeURIComponent(c)}`).join("&");
    const url = `https://firestore.googleapis.com/v1/projects/${idDoProjeto(env)}/databases/(default)/documents/${caminho}?${mascara}`;

    const resposta = await fetch(url, {
        method: "PATCH",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ fields: campos })
    });

    if (!resposta.ok) throw new Error(`Erro ao gravar ${caminho}: ${await resposta.text()}`);
    return true;
}
